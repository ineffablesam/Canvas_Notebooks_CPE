# Copy this file to scripts/.env.panopto and fill in the blanks, then load it
# before running upload_to_panopto.py:
#
#   set -a; source scripts/.env.panopto; set +a
#   python3 scripts/upload_to_panopto.py --dry-run
#
# scripts/.env.panopto is gitignored -- it holds real credentials, never commit it.

# Stevens' Panopto site (from the folder URL you shared) -- no https://, no path.
PANOPTO_SERVER=stevens.hosted.panopto.com

# The course folder that backs the "Panopto Video" tab in this Canvas course
# (from the same URL: #folderID="...").
PANOPTO_FOLDER_ID=5b126df0-5769-4cba-87c7-b49c00e2eb0c

# From Stevens' Panopto admin: System > API Clients > New API Client.
# Client Type = "Server-side Web Application" -- this does a normal one-time
# browser login (through Stevens SSO if that's how you sign in) and caches a
# refresh token, so uploads carry YOUR real creator permissions without ever
# storing your password. Leave PANOPTO_GRANT_TYPE unset -- "authcode" is the
# default and matches this client type.
PANOPTO_CLIENT_ID=
PANOPTO_CLIENT_SECRET=

# Only needed if you deliberately set PANOPTO_GRANT_TYPE=password instead
# (native, non-SSO Panopto accounts only -- see the script's docstring).
PANOPTO_USERNAME=
PANOPTO_PASSWORD=
